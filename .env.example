# TUI-Story Environment Configuration
# ====================================
# The graph lives in PostgreSQL and the application is Elixir. There is no
# second service and no second language.

## Database
# docker-compose brings one up on localhost:5432 with these defaults.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# Production requires a full URL instead, and refuses to start without it:
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE

## LLM
# Relationship extraction calls one of these. With no key set, the client falls
# back to mock relationships so the TUI still runs.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

## Phoenix (production only)
# SECRET_KEY_BASE=
# PHX_HOST=
# PORT=4000

# Logging
LOG_LEVEL=INFO
