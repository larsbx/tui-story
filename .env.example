# TUI-Story Environment Configuration
# ====================================
# This project uses multiple services, each with their own environment configuration.
# Choose the appropriate .env file based on your deployment method:

## For Docker Compose Deployment
# Copy .env.docker to .env and fill in your values
# This handles all services in a containerized environment

## For Local Development

### Graphiti Service (Python/FastAPI)
# Location: graphiti_service/.env.example
# Required variables:
# - NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD
# - ANTHROPIC_API_KEY, OPENAI_API_KEY
# - LLM_PROVIDER, LLM_MODEL

### Semantic Graph Service (Elixir/Phoenix)
# Location: semantic_graph/.env.example
# Required variables:
# - ANTHROPIC_API_KEY, OPENAI_API_KEY
# - LLM_PROVIDER, LLM_MODEL
# - GRAPHITI_BASE_URL
# - NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD
# - SECRET_KEY_BASE, PHX_HOST, PORT

## Shared Configuration Values

# LLM Configuration (used by both services)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# Neo4j Configuration (used by both services)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Logging
LOG_LEVEL=INFO
